# PostgreSQL Connection String Template
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=[SCHEMA]&sslmode=[SSL_MODE]
DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_charter?schema=public"

# NextAuth & Security
NEXTAUTH_SECRET="your-32-character-secret-key-here"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"
